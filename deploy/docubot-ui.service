[Unit]
Description=DocuBot UI
After=network.target

[Service]
Type=simple
User=rj
WorkingDirectory=/home/rj/projects/ai-lab/agnx-internal-docs-chat-ui
ExecStart=/home/rj/.nvm/versions/node/v22.22.2/bin/node node_modules/.bin/next start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
